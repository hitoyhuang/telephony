--- a/configure.ac
+++ b/configure.ac
@@ -35,6 +35,12 @@
 AC_ARG_ENABLE(debug,
     AS_HELP_STRING([--enable-debug], [Enable debug output]))
 
+# 5G NR support
+AC_ARG_ENABLE(5g-nr,
+    AS_HELP_STRING([--enable-5g-nr], [Enable 5G NR support]),
+    [enable_5g_nr=$enableval],
+    [enable_5g_nr=yes])
+
 # Checks for programs
 AC_PROG_CC
 AC_PROG_INSTALL
@@ -72,6 +78,13 @@
     AC_DEFINE(DEBUG_MODE, 1, [Enable debug mode])
 fi
 
+# Enable 5G NR
+if test "x$enable_5g_nr" = "xyes"; then
+    AC_DEFINE(HAVE_5G_NR, 1, [Enable 5G NR support])
+    AC_DEFINE(SUPPORT_VONR, 1, [Enable VoNR support])
+    AC_MSG_NOTICE([5G NR support enabled])
+fi
+
 # Checks for libraries
 PKG_CHECK_MODULES([ASTERISK], [asterisk])
